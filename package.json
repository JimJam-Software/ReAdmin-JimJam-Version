  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "nlint": "next lint",
    "lint": "eslint --ext \".js,.ts,.tsx\" --report-unused-disable-directives --report-unused-disable-directives src",
    "lint-fix": "eslint --ext \".js,.ts,.tsx\" --report-unused-disable-directives --report-unused-disable-directives src --fix",
    "prettier": "npx prettier --write .",
    "test": "npx jest --config jest.config.ts",
    "API_RELATED_THINGS": "echo 'API_RELATED_THINGS'",
    "fastify:build": "tsc -p ./src/fastifyAPI/tsconfig.json",
    "fastify:clean": "tsc --build ./src/fastifyAPI/tsconfig.json --clean",
    "fastify:start": "node ./apiBuild/fastifyAPI/index",
    "sync:start": "node ./apiBuild/fastifyAPI/sync.index",
    "fastify:dev": "concurrently \"tsc -w -p ./src/fastifyAPI/tsconfig.json\" \"nodemon ./apiBuild/fastifyAPI/index\"",
    "api:dev": "concurrently \"tsc -w -p ./src/fastifyAPI/tsconfig.json\" \"nodemon --watch ./apiBuild/fastifyAPI --watch ./apiBuild/server --watch ./apiBuild/services ./apiBuild/fastifyAPI/index\""
  },
  "_moduleAliases": {
    "~": "apiBuild/"
  },
  "prettier": {
    "printWidth": 80,
    "trailingComma": "all",
    "singleQuote": true
  },
