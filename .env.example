# ReAdmin — self-hosted environment.
#
#   cp .env.example .env   and fill every value in before the first build.
#
# next.config.js requires src/services/env.js at the top, so the COMPLETE
# server environment must be present at BUILD time, not just at runtime. A
# missing value fails `docker compose build`, not the first request.
#
# Replace every occurrence of example.com with your own domain.
#
# Every variable below must be NON-EMPTY unless marked optional. The schema
# rejects blank strings, and some services build clients at import time, so a
# blank value fails the build rather than degrading gracefully at runtime.

# ─── Deployment ──────────────────────────────────────────────────────────────
NODE_ENV=production
# Selects which entry in the hardcoded host tables is used (src/utils/trpc.ts,
# the CORS allowlist in src/fastifyAPI/index.ts). Legacy name — nothing about
# it requires Vercel.
NEXT_PUBLIC_VERCEL_ENV=production
# Unlocks the workspace import tooling used to restore a bundle exported from
# the hosted site.
SELF_HOSTED=true
APP_NAME=panel
# devDependencies must install — `fastify:build` runs tsc.
NPM_CONFIG_PRODUCTION=false

# ─── Hostnames (read by Caddy, not by the app) ───────────────────────────────
PANEL_DOMAIN=panel.example.com
API_DOMAIN=api.example.com
CDN_DOMAIN=cdn.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=readmin
# CHANGE THIS. `openssl rand -hex 24`
MONGO_ROOT_PASSWORD=
MONGODB_URI=mongodb://readmin:CHANGE_ME@mongo:27017/?authSource=admin
MONGODB_DATABASE=readmin
# The container has no TLS certificate. Managed clusters need this unset.
MONGODB_TLS=false

# ─── Redis ───────────────────────────────────────────────────────────────────
# redis:// not rediss:// — the container speaks plaintext on the private network.
REDIS_URL=redis://redis:6379

# ─── Object storage (MinIO) ──────────────────────────────────────────────────
# CDN_ENDPOINT must be the PUBLIC hostname: presigned URLs are signed against
# it and handed to the browser, so an internal address like http://minio:9000
# produces links nobody can open.
CDN_ENDPOINT=https://cdn.example.com
CDN_URL=https://cdn.example.com
CDN_BUCKET_NAME=readmin-cdn
# MinIO ignores the region, but the schema requires it. The misspelling is
# intentional — it matches the variable the code reads.
CDN_REIGON=us-east-1
# Required for MinIO on a single hostname.
CDN_FORCE_PATH_STYLE=true
# These double as the MinIO root credentials. CHANGE BOTH.
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=

# ─── Secrets ─────────────────────────────────────────────────────────────────
# EXACTLY 32 characters — used verbatim as an AES-256-CBC key. Changing it
# later invalidates every stored OAuth token. `openssl rand -hex 16`
CRYPTO_KEY=
# `openssl rand -hex 32`
JSON_WEB_TOKEN_SECRET=

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
# Same value as DISCORD_CLIENT_ID. Needed at build time — it is inlined into
# the client bundle.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=

# ─── Roblox ──────────────────────────────────────────────────────────────────
# ROBLOX_CLIENT_ID must also be pasted into the four hardcoded authorize URLs
# listed in README §6, or login fails.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_API_KEY=
ROBLOX_COOKIE=
ROBLOX_USER_ID=

# ─── Bloxlink ────────────────────────────────────────────────────────────────
BLOXLINK_TOKEN=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Needed even with billing switched off. stripe.service.ts constructs its
# client at import time, so an EMPTY STRIPE_SECRET fails the build with
# "Neither apiKey nor config.authenticator provided" — it is not enough to
# leave these blank. Test-mode keys, or the dummy values below, satisfy it;
# signups are closed while READMIN_IS_SHUTTING_DOWN is true.
STRIPE_PUBLIC=pk_test_dummy
STRIPE_SECRET=sk_test_dummy
STRIPE_SIGNING_SECRET=whsec_dummy

# ─── Required by the schema but unused by the code ───────────────────────────
# Any non-empty value will do. Blank fails validation.
ROBLOX_SECRET=unused
AWS_ACCESS_KEY_ID=unused
AWS_SECRET_ACCESS_KEY=unused
CONTIGUITY_SECRET=unused

# ─── Zen Firewall by Aikido ──────────────────────────────────────────────────
# Zen is preloaded into all three processes (see the `command:` entries in
# docker-compose.yml). With no AIKIDO_TOKEN set it prints one line saying it is
# disabled and gets out of the way, so leaving this blank is safe.
#
# Start in dry mode. Aikido recommend running detection-only for about two
# weeks to shake out false positives before switching to blocking.
AIKIDO_BLOCK=false
# AIKIDO_TOKEN=AIK_RUNTIME_...
# Verbose agent logging — which modules were instrumented, what it is doing.
# AIKIDO_DEBUG=true

# ─── Optional ────────────────────────────────────────────────────────────────
# Omit entirely to disable OpenSearch-backed Roblox user search.
# OPENSEARCH_URL=
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
